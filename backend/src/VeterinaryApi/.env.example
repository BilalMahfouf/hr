# ─── Database ────────────────────────────────────────────────────────────────
# Connection string used by EF Core / Npgsql (Docker service name for the host)
DefaultConnection="Host=<db-host>;Port=5432;Database=veterinary_db;Username=<db-user>;Password=<db-password>;Pooling=true;Minimum Pool Size=5;Maximum Pool Size=100;"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY="<32-char-random-secret>"
JWT_ISSUER="https://<your-api-domain>"
JWT_AUDIENCE="https://<your-frontend-domain>"
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15

# ─── Email (SMTP via Gmail or any SMTP relay) ────────────────────────────────
EMAIL_CONFIGURATIONS_EMAIL="<smtp-sender-address>"
EMAIL_CONFIGURATIONS_PASSWORD="<smtp-app-password>"
EMAIL_CONFIGURATIONS_HOST="smtp.gmail.com"
EMAIL_CONFIGURATIONS_PORT=587

# ─── Resend (transactional email API) ────────────────────────────────────────
RESEND_APITOKEN="<resend-api-token>"

# ─── Web Push / VAPID ────────────────────────────────────────────────────────
# Generate a VAPID key pair ONCE per deployment with:
#   npx web-push generate-vapid-keys
# Never regenerate in production — existing browser subscriptions will break.
#
# The public key is shared with browsers via GET /push/vapid-public-key.
# The private key NEVER leaves the server.
# Subject must be a mailto: or https: URI identifying the application owner.
WEBPUSH_VAPID_PUBLIC_KEY="<url-safe-base64-vapid-public-key>"
WEBPUSH_VAPID_PRIVATE_KEY="<url-safe-base64-vapid-private-key>"
WEBPUSH_SUBJECT="mailto:<admin-email>"
